# ACDV Wi-Fi Captive Portal — nftables rules
# Review the interface names and addresses for your gateway before installation.
# This table is replaced as a whole by apply_nftables.sh on install/boot.

table inet quy-tac-mang {
    set danh_sach_v4 {
        type ipv4_addr
        flags timeout
        timeout 1h
    }

    set home {
        type ipv4_addr
        flags dynamic
        elements = { 10.10.10.13 }
    }

    chain nat_masquerade {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wlp2s0" masquerade
    }

    chain forward_filter {
        type filter hook forward priority filter; policy drop;
        ip saddr @home accept
        ip saddr @danh_sach_v4 accept
        ct state established,related accept
    }

    chain nat_redirect {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "enp0s31f6" ip saddr != @danh_sach_v4 ip saddr != @home udp dport 53 dnat to 10.10.10.1:53
        iifname "enp0s31f6" ip saddr != @danh_sach_v4 ip saddr != @home tcp dport 80 redirect to :8080
        iifname "enp0s31f6" ip daddr 10.10.10.1 tcp dport 80 redirect to :8080
        iifname "enp0s31f6" ip daddr 192.168.1.1 tcp dport 80 redirect to :8080
    }
}
